{
  "name": "@grimoire/server",
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "grimoire": "./src/cli.ts"
  },
  "scripts": {
    "dev": "bun run --watch src/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "seed": "bun run src/cli.ts seed",
    "db:generate": "drizzle-kit generate",
    "db:generate:custom": "drizzle-kit generate --custom",
    "test:db-smoke:node": "node --import tsx --test test/db-smoke.test.ts"
  },
  "dependencies": {
    "@grimoire/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.3",
    "js-yaml": "^5.3.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^5.9.0"
  }
}
